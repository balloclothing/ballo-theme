{% doc %}
  Cart contents shared by the cart drawer and the cart page:
  free shipping progress, line items with quantity controls, subtotal and checkout.
  Works without JavaScript (form posts to /cart); cart.js enhances it in place.

  @param {string} context - 'drawer' or 'page'

  @example
  {% render 'cart-contents', context: 'drawer' %}
{% enddoc %}
{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = 100
  if threshold > 0 and remaining > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
  endif
  assign form_id = 'CartForm-' | append: context
-%}

<div class="cart cart--{{ context }}" data-item-count="{{ cart.item_count }}">
  {%- if cart.item_count == 0 -%}
    <div class="cart__empty">
      <p class="cart__empty-text">{{ 'cart.empty' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    {%- if threshold > 0 -%}
      <div class="cart__shipping">
        <p class="cart__shipping-text">
          {%- if remaining > 0 -%}
            {%- assign remaining_money = remaining | money_without_trailing_zeros -%}
            {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
          {%- else -%}
            {{ 'cart.free_shipping_reached' | t }}
          {%- endif -%}
        </p>
        <div
          class="cart__progress"
          role="progressbar"
          aria-label="{{ 'cart.free_shipping_progress' | t }}"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{ progress }}"
        >
          <span class="cart__progress-bar" style="--progress: {{ progress }}%;"></span>
        </div>
      </div>
    {%- endif -%}

    <form action="{{ routes.cart_url }}" method="post" id="{{ form_id }}" class="cart__form" novalidate>
      <ul class="cart__items" role="list">
        {%- for item in cart.items -%}
          {%- assign quantity_id = form_id | append: '-qty-' | append: forloop.index -%}
          <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
            <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{
                  item.image
                  | image_url: width: 240
                  | image_tag: widths: '120, 180, 240', sizes: '120px', loading: 'lazy', alt: ''
                }}
              {%- endif -%}
            </a>

            <div class="cart-item__details">
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-item__options">
                  {%- for option in item.options_with_values -%}
                    {{ option.name }}: {{ option.value }}
                    {%- unless forloop.last %} · {% endunless -%}
                  {%- endfor -%}
                </p>
              {%- endunless -%}

              {%- for discount in item.line_level_discount_allocations -%}
                <p class="cart-item__discount">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
              {%- endfor -%}

              <div class="cart-item__actions">
                <div class="quantity">
                  <button
                    type="button"
                    class="quantity__button"
                    data-quantity-change="-1"
                    aria-label="{{ 'cart.decrease' | t: product: item.product.title }}"
                  >
                    −
                  </button>
                  <label class="visually-hidden" for="{{ quantity_id }}">
                    {{- 'cart.quantity_for' | t: product: item.product.title -}}
                  </label>
                  <input
                    class="quantity__input"
                    id="{{ quantity_id }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    inputmode="numeric"
                    data-quantity-input
                  >
                  <button
                    type="button"
                    class="quantity__button"
                    data-quantity-change="1"
                    aria-label="{{ 'cart.increase' | t: product: item.product.title }}"
                  >
                    +
                  </button>
                </div>

                <a class="cart-item__remove" href="{{ item.url_to_remove }}" data-remove>
                  {{- 'cart.remove' | t -}}
                  <span class="visually-hidden">{{ item.product.title }}</span>
                </a>
              </div>
            </div>

            <p class="cart-item__price">
              {%- if item.original_line_price > item.final_line_price -%}
                <s class="text-secondary">{{ item.original_line_price | money }}</s>
              {%- endif -%}
              {{ item.final_line_price | money }}
            </p>
          </li>
        {%- endfor -%}
      </ul>

      <noscript>
        <button type="submit" class="button button--secondary cart__update">{{ 'cart.update' | t }}</button>
      </noscript>
    </form>

    <div class="cart__footer">
      {%- for discount in cart.cart_level_discount_applications -%}
        <p class="cart__line">
          <span>{{ discount.title }}</span>
          <span>−{{ discount.total_allocated_amount | money }}</span>
        </p>
      {%- endfor -%}

      <p class="cart__line cart__subtotal">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span>{{ cart.total_price | money_with_currency }}</span>
      </p>
      <p class="cart__note text-secondary">{{ 'cart.taxes_note' | t }}</p>

      <button type="submit" name="checkout" form="{{ form_id }}" class="button cart__checkout">
        {{- 'cart.checkout' | t -}}
      </button>

      {%- if context == 'drawer' -%}
        <a class="cart__view-link" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

</div>
