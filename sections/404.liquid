<div class="not-found container">
  <p class="eyebrow">{{ '404.title' | t }}</p>
  <h1>{{ section.settings.heading }}</h1>
  <p class="text-secondary">{{ section.settings.text }}</p>
  <div class="not-found__actions">
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
    <a class="button button--secondary" href="{{ routes.root_url }}">{{ '404.home' | t }}</a>
  </div>
</div>

{% stylesheet %}
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 640px;
    padding-block: clamp(64px, 10vw, 160px);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Página no encontrada",
  "tag": "section",
  "class": "section-404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Esta página no existe."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "default": "Puede que el enlace esté mal escrito o que la página ya no esté disponible."
    }
  ]
}
{% endschema %}
