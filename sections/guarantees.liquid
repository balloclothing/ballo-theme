<div class="guarantees section section--{{ section.settings.background }} full-width">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="visually-hidden">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="guarantees__list" role="list">
      {%- for block in section.blocks -%}
        <li class="guarantees__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="guarantees__icon">{% render 'icon', name: block.settings.icon %}</span>
          {%- endif -%}
          <div class="guarantees__body">
            {%- if block.settings.title != blank -%}
              <h3 class="guarantees__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="guarantees__text text-secondary">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .guarantees {
    padding-block: clamp(48px, 6vw, 80px);
  }

  .guarantees__list {
    display: grid;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guarantees__item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .guarantees__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-accent);
  }

  .guarantees__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 4px;
  }

  .guarantees__title {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .guarantees__text {
    font-size: 0.9375rem;
  }

  @media (min-width: 750px) {
    .guarantees__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Garantías",
  "tag": "section",
  "class": "section-guarantees",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "background", "label": "Fondo (Ivory)" },
        { "value": "surface", "label": "Superficie" }
      ],
      "default": "background"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (solo para lectores de pantalla)",
      "default": "Nuestras garantías"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantía",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "exchange", "label": "Cambios" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "none", "label": "Ninguno" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío a todo Colombia"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Garantías",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Envío a todo Colombia" } },
        { "type": "item", "settings": { "icon": "exchange", "title": "Cambios en 30 días" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Pago seguro" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
