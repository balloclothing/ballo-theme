{%- assign form_id = 'Waitlist-' | append: section.id -%}

<div
  class="coming-soon section section--{{ section.settings.background }} full-width"
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
>
  <div class="coming-soon__inner container">
    <div class="coming-soon__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="text-secondary rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', id: form_id, class: 'waitlist-form' -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.tag | escape }}">

        <div class="newsletter-form__row">
          <div class="field newsletter-form__field">
            <label class="field__label" for="{{ form_id }}-email">{{ 'newsletter.email_label' | t }}</label>
            <input
              class="field__input"
              id="{{ form_id }}-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              placeholder="{{ 'newsletter.email_placeholder' | t }}"
              required
              {% if form.errors %}
                aria-invalid="true" aria-describedby="{{ form_id }}-message"
              {% endif %}
            >
          </div>
          <button type="submit" class="button">{{ section.settings.button_label }}</button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="form-message" id="{{ form_id }}-message" role="status" data-form-message="{{ form_id }}">
            {{ section.settings.success_message }}
          </p>
        {%- elsif form.errors -%}
          <p class="form-message form-message--error" id="{{ form_id }}-message" role="alert" data-form-message="{{ form_id }}">
            {%- if form.errors.messages.email -%}
              {{ 'newsletter.error_email' | t }}
            {%- else -%}
              {{ form.errors | default_errors }}
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="coming-soon__cards" role="list">
        {%- for block in section.blocks -%}
          <li class="coming-soon__card" {{ block.shopify_attributes }}>
            <div class="coming-soon__art">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    widths: '300, 400, 600, 800',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    loading: 'lazy',
                    class: 'coming-soon__image'
                }}
              {%- else -%}
                {% render 'illustration', name: block.settings.illustration, label: block.settings.caption %}
              {%- endif -%}
            </div>
            {%- if block.settings.caption != blank -%}
              <p class="coming-soon__caption" aria-hidden="true">{{ block.settings.caption }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .coming-soon__inner {
    display: grid;
    gap: 48px;
  }

  .coming-soon__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 560px;
  }

  .waitlist-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 12px;
  }

  .coming-soon__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .coming-soon__card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background-color: var(--color-card);
    overflow: hidden;
  }

  .coming-soon__art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: 12%;
    color: var(--color-accent);
  }

  .coming-soon__art .illustration {
    width: 100%;
    height: 100%;
  }

  .coming-soon__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .coming-soon__caption {
    padding: 14px 16px;
    border-top: 1px solid var(--color-line);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  @media (min-width: 990px) {
    .coming-soon__inner {
      grid-template-columns: 5fr 6fr;
      align-items: center;
      gap: clamp(48px, 6vw, 96px);
    }

    .coming-soon__cards {
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Próximamente",
  "tag": "section",
  "class": "section-coming-soon",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "background", "label": "Fondo (Ivory)" },
        { "value": "surface", "label": "Superficie" }
      ],
      "default": "background"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeño",
      "default": "Próximamente · Costa · Bordado monolínea"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Un solo trazo, bordado a mano."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Costa es nuestra próxima línea: ilustraciones de un solo trazo, bordadas en bronce. Déjanos tu correo y te avisamos antes que a nadie.</p>"
    },
    {
      "type": "header",
      "content": "Formulario"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Avísame"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Etiqueta del cliente",
      "info": "Los correos se guardan como clientes con esta etiqueta. Así puedes filtrarlos en Clientes y escribirles con Shopify Email.",
      "default": "costa-waitlist"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Mensaje de confirmación",
      "default": "¡Listo! Te avisaremos cuando Costa esté disponible."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancla",
      "info": "Permite enlazar a esta sección con #ancla (por ejemplo, /#costa desde el menú).",
      "default": "costa"
    }
  ],
  "blocks": [
    {
      "type": "illustration",
      "name": "Ilustración",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "illustration",
          "label": "Ilustración",
          "options": [
            { "value": "palmera", "label": "Palmera" },
            { "value": "faro", "label": "Faro" }
          ],
          "default": "palmera"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (opcional)",
          "info": "Si subes una imagen, reemplaza la ilustración. Proporción 4:5."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Texto",
          "default": "Palmera"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Próximamente",
      "blocks": [
        { "type": "illustration", "settings": { "illustration": "palmera", "caption": "Palmera" } },
        { "type": "illustration", "settings": { "illustration": "faro", "caption": "Faro" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
