<div class="page-content container">
  <header class="page-content__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1>{{ page.title }}</h1>
  </header>

  <div class="page-content__body rte">
    {{ page.content }}
  </div>
</div>

{% stylesheet %}
  .page-content {
    max-width: 760px;
    padding-block: clamp(40px, 6vw, 88px) clamp(64px, 8vw, 120px);
  }

  .page-content__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .page-content__body {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .page-content__body h2,
  .page-content__body h3 {
    margin-top: 1.6em;
  }

  .page-content__body img {
    border-radius: var(--radius);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Página",
  "tag": "section",
  "class": "section-page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeño (opcional)"
    }
  ]
}
{% endschema %}
