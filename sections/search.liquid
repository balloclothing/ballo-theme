<div class="search-page container">
  <header class="search-page__header section-heading">
    <h1>{{ 'search.title' | t }}</h1>

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="options[prefix]" value="last">
      <div class="field search-form__field">
        <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'search.label' | t }}</label>
        <input
          class="field__input search-form__input"
          id="SearchInput-{{ section.id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
        >
      </div>
      <button type="submit" class="button">
        {% render 'icon', name: 'search' %}
        {{ 'search.submit' | t }}
      </button>
    </form>
  </header>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.filters.size > 0 -%}
        {% render 'facets',
          results: search,
          url: routes.search_url,
          section_id: section.id,
          count: search.results_count
        %}
      {%- endif -%}

      <div data-facets-results>
        {%- if search.results_count == 0 -%}
          <p class="search-page__summary">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
          <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">
            {{- 'cart.continue_shopping' | t -}}
          </a>
        {%- else -%}
          {%- unless search.filters.size > 0 -%}
            <p class="search-page__summary">
              {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
            </p>
          {%- endunless -%}

          <ul class="product-grid" role="list">
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                <li>{% render 'product-card', product: result %}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- assign other_results = search.results | where: 'object_type', 'page' -%}
          {%- assign article_results = search.results | where: 'object_type', 'article' -%}
          {%- assign other_results = other_results | concat: article_results -%}
          {%- if other_results.size > 0 -%}
            <h2 class="search-page__subheading h4">{{ 'search.pages' | t }}</h2>
            <ul class="search-page__links" role="list">
              {%- for result in other_results -%}
                <li>
                  <a href="{{ result.url }}">{{ result.title }}</a>
                  {%- assign excerpt = result.content | strip_html | truncatewords: 24 -%}
                  {%- if excerpt != blank -%}
                    <p class="text-secondary">{{ excerpt }}</p>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .search-page {
    padding-block: clamp(32px, 5vw, 64px) clamp(64px, 8vw, 120px);
  }

  .search-form {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    width: 100%;
  }

  .search-form__field {
    flex: 1 1 260px;
  }

  .search-page__summary {
    margin-bottom: 32px;
    color: var(--color-text-secondary);
  }

  .search-page__subheading {
    margin-block: 56px 16px;
  }

  .search-page__links {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .search-page__links li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-line);
  }

  .search-page__links a {
    font-weight: 500;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Búsqueda",
  "tag": "section",
  "class": "section-search",
  "settings": []
}
{% endschema %}
