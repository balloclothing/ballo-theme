{%- liquid
  assign collection = section.settings.collection
  assign max_cards = section.settings.max_cards
  assign card_count = 0
  assign show_filters = false
  if section.settings.show_filters and collection.products_count > 1
    assign show_filters = true
  endif
  assign grid_id = 'ProductGrid-' | append: section.id
-%}

<div
  class="featured-products section section--{{ section.settings.background }} full-width"
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handleize }}"
  {% endif %}
>
  <div class="container">
    <div class="featured-products__header">
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.link_label != blank and collection -%}
        <a class="link-arrow featured-products__view-all" href="{{ collection.url }}">
          {{- section.settings.link_label }}
          {% render 'icon', name: 'arrow-right', class: 'link-arrow__icon' %}
        </a>
      {%- endif -%}
    </div>

    <filter-chips
      data-status-one="{{ 'featured_products.status_one' | t }}"
      data-status-other="{{ 'featured_products.status_other' | t }}"
    >
      {%- if show_filters -%}
        <ul class="chips" role="list" aria-label="{{ 'featured_products.filter_label' | t }}">
          <li>
            <button type="button" class="chip" aria-pressed="true" aria-controls="{{ grid_id }}" data-filter="">
              {{- 'featured_products.all' | t -}}
            </button>
          </li>
          {%- for product in collection.products limit: 12 -%}
            <li>
              <button
                type="button"
                class="chip"
                aria-pressed="false"
                aria-controls="{{ grid_id }}"
                data-filter="{{ product.id }}"
              >
                {{- product.title -}}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <ul
        class="product-grid"
        id="{{ grid_id }}"
        role="list"
        style="--columns-desktop: {{ section.settings.columns_desktop }};"
      >
        {%- if collection and collection.products_count > 0 -%}
          {%- for product in collection.products limit: 50 -%}
            {%- liquid
              assign color_values = nil
              if section.settings.card_per_color
                for option in product.options_with_values
                  assign option_name = option.name | downcase
                  if option_name == 'color' or option_name == 'colour'
                    assign color_values = option.values
                  endif
                endfor
              endif
            -%}

            {%- if color_values -%}
              {%- for value in color_values -%}
                {%- if card_count < max_cards -%}
                  <li data-product-id="{{ product.id }}">
                    {% render 'product-card', product: product, color: value.name %}
                  </li>
                  {%- assign card_count = card_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            {%- elsif card_count < max_cards -%}
              <li data-product-id="{{ product.id }}">
                {% render 'product-card', product: product %}
              </li>
              {%- assign card_count = card_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li>{% render 'product-card' %}</li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      <p class="visually-hidden" aria-live="polite" data-filter-status></p>
    </filter-chips>
  </div>
</div>

{% stylesheet %}
  .featured-products__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 24px;
  }

  .featured-products__view-all {
    gap: 8px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Esenciales",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "background", "label": "Fondo (Ivory)" },
        { "value": "surface", "label": "Superficie" }
      ],
      "default": "background"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeño",
      "default": "Esenciales"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Las de todos los días."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "checkbox",
      "id": "card_per_color",
      "label": "Mostrar una tarjeta por color",
      "info": "Ejemplo: «Páramo 260 — Hueso», «Páramo 260 — Ink»…",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Mostrar chips de filtro por línea",
      "default": true
    },
    {
      "type": "range",
      "id": "max_cards",
      "label": "Máximo de tarjetas",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace a la colección",
      "default": "Ver todas"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Ancla",
      "info": "Permite enlazar a esta sección con #ancla.",
      "default": "esenciales"
    }
  ],
  "presets": [
    {
      "name": "Esenciales"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
