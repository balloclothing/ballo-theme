<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Preload the main font files so text renders in the brand fonts quickly %}
    {{ settings.font_heading | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ settings.font_body | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- unless template.name == 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endunless -%}
  </body>
</html>
